{
  "name": "workflow-depot-integration-coordinator",
  "main": "../src/integration-coordinator-worker.mjs",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "vars": {
    "ENABLED": "false",
    "INTEGRATION_REPOSITORY_ID": "0",
    "SIGNING_CONFIGURATION_DIGEST": ""
  },
  "observability": {
    "enabled": false
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "INTEGRATION_STATE",
        "class_name": "IntegrationRepository"
      }
    ]
  },
  "migrations": [
    {
      "tag": "integration-v1",
      "new_sqlite_classes": [
        "IntegrationRepository"
      ]
    }
  ]
}
