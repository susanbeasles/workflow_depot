{
  "name": "workflow-depot-build-provenance",
  "main": "../src/deployment-provenance-worker.mjs",
  "compatibility_date": "2026-10-08",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "vars": {
    "ENABLED": "false",
    "DEPLOYMENT_POLICY_JSON": "{\"schema\":\"workflow-depot-cloudflare-policy/v1\",\"revision\":1,\"enabled\":false,\"authorizer\":{},\"executor\":{},\"targets\":[],\"maxArtifactBytes\":5242880,\"verification\":{}}"
  },
  "durable_objects": {"bindings": [{"name": "BUILD_PROVENANCE_STATE", "class_name": "BuildProvenanceState"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["BuildProvenanceState"]}],
  "r2_buckets": [{"binding": "DEPLOYMENT_ARTIFACTS", "bucket_name": "workflow-depot-artifacts"}],
  "observability": {"enabled": true, "logs": {"enabled": true, "invocation_logs": false}}
}
