{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "./.guard/hooks/session-start.sh", "timeout": 5 } ] }
    ],
    "PreToolUse": [
      { "matcher": "", "hooks": [ { "type": "command", "command": "./.guard/hooks/pre-tool-guard.sh", "timeout": 10 } ] }
    ],
    "PostToolUse": [
      { "matcher": "", "hooks": [ { "type": "command", "command": "./.guard/hooks/post-edit-check.sh", "timeout": 120 } ] },
      { "matcher": "", "hooks": [ { "type": "command", "command": "./.guard/hooks/session-log.sh", "timeout": 5 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "./.guard/hooks/stop-gate.sh", "timeout": 600 } ] }
    ]
  }
}
